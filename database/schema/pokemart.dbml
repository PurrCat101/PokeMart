Project pokemart_api_lab {
  database_type: 'MySQL'
  Note: 'DBML source for the PokéMart schema. Paste this file into dbdiagram.io to view or edit the ERD.'
}

Table pokemon_reference {
  source_id int [pk, not null]
  name varchar(64) [not null, unique]
  base_experience "smallint unsigned" [not null]
  types json [not null]
  sprite_url varchar(512)

  Note: 'Seeded reference snapshot. This is the parent catalog for listings, inventory, and purchase history.'
}

Table shop_listing {
  pokemon_source_id int [pk, not null]
  price int [not null]
  stock int [not null]
  active boolean [not null, default: true]

  checks {
    `price >= 0` [name: 'chk_listing_price']
    `stock >= 0` [name: 'chk_listing_stock']
  }

  Note: 'At most one shop listing per Pokémon. Price and stock are PokéMart-owned values.'
}

Table user_wallet {
  user_id varchar(64) [pk, not null, note: 'Logical user identifier; there is no users table or user foreign key.']
  balance int [not null]

  checks {
    `balance >= 0` [name: 'chk_wallet_balance']
  }
}

Table user_inventory {
  user_id varchar(64) [not null, note: 'Logical user identifier; there is no users table or user foreign key.']
  pokemon_source_id int [not null]
  quantity int [not null]

  indexes {
    (user_id, pokemon_source_id) [pk]
  }

  checks {
    `quantity > 0` [name: 'chk_inventory_quantity']
  }
}

Table purchases {
  id char(36) [pk, not null, note: 'Client-generated purchase UUID; committed IDs are unique.']
  user_id varchar(64) [not null, note: 'Logical user identifier; there is no users table or user foreign key.']
  pokemon_source_id int [not null]
  quantity int [not null]
  unit_price int [not null, note: 'Price snapshot at purchase time.']
  total_price int [not null, note: 'Price snapshot at purchase time.']
  created_at timestamp(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  indexes {
    (user_id, created_at, id) [name: 'idx_purchase_user_created', note: 'created_at and id are DESC in the MySQL schema']
  }

  checks {
    `quantity between 1 and 99` [name: 'chk_purchase_quantity']
  }

  Note: 'Purchase history snapshots pricing and references the Pokémon, not the shop listing.'
}

Ref fk_listing_pokemon: pokemon_reference.source_id - shop_listing.pokemon_source_id
Ref fk_inventory_pokemon: pokemon_reference.source_id < user_inventory.pokemon_source_id
Ref fk_purchase_pokemon: pokemon_reference.source_id < purchases.pokemon_source_id
