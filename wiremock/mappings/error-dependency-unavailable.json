{
  "priority": 1,
  "request": {
    "urlPathPattern": "/api/.*",
    "headers": { "X-WireMock-Scenario": { "equalTo": "dependency-unavailable" } }
  },
  "response": {
    "status": 503,
    "headers": { "Content-Type": "application/json", "X-Request-Id": "wiremock-request" },
    "jsonBody": { "error": { "code": "DEPENDENCY_UNAVAILABLE", "message": "Catalog service is temporarily unavailable", "requestId": "wiremock-request", "details": [] } }
  }
}
