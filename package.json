{
  "name": "pokemart-api-lab",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "tests"],
  "scripts": {
    "build": "npm run build --workspace=@pokemart/bff --workspace=@pokemart/api --workspace=@pokemart/payment-mock --workspace=@pokemart/kyc-api",
    "build:web": "npm run build --workspace=@pokemart/web",
    "lint:web": "npm run lint --workspace=@pokemart/web",
    "dev": "npm run dev --workspace=@pokemart/web",
    "start:web": "npm run start --workspace=@pokemart/web",
    "start:bff": "npm run start --workspace=@pokemart/bff",
    "start:api": "npm run start --workspace=@pokemart/api",
    "start:worker": "npm run start:worker --workspace=@pokemart/api",
    "start:shipping-mock": "npm run start --workspace=@pokemart/shipping-mock",
    "start:payment-mock": "npm run start --workspace=@pokemart/payment-mock",
    "start:kyc-api": "npm run start --workspace=@pokemart/kyc-api",
    "test": "npm run test --workspace=@pokemart/tests",
    "test:report": "npm run test:report --workspace=@pokemart/tests",
    "test:mocked": "npm run test:mocked --workspace=@pokemart/tests",
    "test:ui": "npm run test:ui --workspace=@pokemart/tests",
    "test:api": "npm run test:api --workspace=@pokemart/tests",
    "test:pokeapi": "npm run test:pokeapi --workspace=@pokemart/tests",
    "test:purchase-retry": "npm run test:purchase-retry --workspace=@pokemart/tests",
    "test:e2e": "npm run test:e2e --workspace=@pokemart/tests",
    "test:items": "npm run test:items --workspace=@pokemart/tests",
    "test:shipping": "npm run test:shipping --workspace=@pokemart/tests",
    "test:observability": "npm run test:observability --workspace=@pokemart/tests",
    "sync-shipment": "tsx scripts/sync-shipment-to-db.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "mysql2": "^3.11.5",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
